{
  "name": "edf-lab-educativo",
  "private": true,
  "description": "Laboratorio educativo Express + dashboard — scripts Compose en la raíz del repo",
  "scripts": {
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile prod up --build",
    "compose:prod:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile prod down",
    "compose:prod:vps": "docker compose -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.vps.yml --profile prod up --build",
    "compose:prod:vps:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.vps.yml --profile prod down",
    "compose:logs": "docker compose logs -f",
    "test": "npm test --prefix api",
    "test:pg": "npm run test:pg --prefix api",
    "test:db:prepare": "npm run test:db:prepare --prefix api",
    "test:e2e": "playwright test --config=e2e/playwright.config.js --project=vanilla-chromium --project=react-chromium --project=vue-chromium",
    "test:e2e:crud": "playwright test crud --config=e2e/playwright.config.js --project=vanilla-chromium --project=react-chromium --project=vue-chromium",
    "test:e2e:ci": "playwright test --config=e2e/playwright.config.js --project=vanilla-chromium --project=react-chromium --project=vue-chromium --project=vanilla-firefox --project=react-firefox --project=vue-firefox",
    "test:e2e:firefox": "playwright test --config=e2e/playwright.config.js --project=vanilla-firefox --project=react-firefox --project=vue-firefox",
    "test:e2e:pg": "playwright test --config=e2e/playwright.config.pg.js",
    "test:visual": "playwright test --config=e2e/playwright.config.js --project=vanilla-chromium-visual --project=react-chromium-visual --project=vue-chromium-visual",
    "test:visual:ci": "playwright test --config=e2e/playwright.config.js --project=vanilla-chromium-visual --project=react-chromium-visual --project=vue-chromium-visual",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.js --ui --project=vanilla-chromium --project=react-chromium --project=vue-chromium",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.js --headed --project=vanilla-chromium --project=react-chromium --project=vue-chromium",
    "playwright:install": "playwright install chromium",
    "playwright:install:ci": "playwright install chromium firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
