# Copia este archivo a .env y ajusta los valores (nunca subas .env al repositorio).
# Desde api/: cp .env.example .env

# --- Arranque ---
# compose:prod (perfil prod) exige JWT_SECRET en este .env (fail-fast) y DATABASE_URL
# apuntando a edf-lab-postgres. NODE_ENV=production lo inyecta docker-compose.prod.yml.
# En desarrollo host (PORT=3100) no uses NODE_ENV=production salvo que pruebes fail-fast.

# --- Autenticación ---
# Define JWT_SECRET en tu .env: cadena larga aleatoria (nunca en git ni en este ejemplo)
JWT_EXPIRES_IN=24h

# Cuenta operador inicial (solo se crea si la tabla accounts está vacía)
ADMIN_EMAIL=admin@lab.local
ADMIN_PASSWORD=changeme

# --- Rate limiting (login) ---
# Ventana en milisegundos para POST /auth/login (por IP)
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Máximo de intentos por ventana (respuesta 429 si se supera)
# LOGIN_RATE_LIMIT_MAX=10

# --- CORS ---
# Orígenes del dashboard (vanilla, React, Vue) para CORS con cookies
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# --- Base de datos ---
# Postgres en Compose (hostname interno del servicio edf-lab-postgres)
# DATABASE_URL=postgresql://edf_lab:edf_lab_dev@edf-lab-postgres:5432/edf_lab

# Postgres desde el host (sin Compose)
# DATABASE_URL=postgresql://edf_lab:edf_lab_dev@localhost:5432/edf_lab

# Ruta SQLite alternativa (tests)
# DB_FILE=data/users.test.db

# --- Solo tests ---
# Nunca en producción — desactiva requireAuth en la suite CRUD
# AUTH_DISABLED=1
