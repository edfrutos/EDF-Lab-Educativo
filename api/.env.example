# Copia este archivo a .env y ajusta los valores (nunca subas .env al repositorio).
# Desde api/: cp .env.example .env

# Clave para firmar JWT: en tu archivo .env, define JWT_SECRET con una cadena larga y aleatoria (no la pegues aquí).

# Duración de la sesión del operador
JWT_EXPIRES_IN=24h

# Cuenta operador inicial (solo se crea si la tabla accounts está vacía)
ADMIN_EMAIL=admin@lab.local
ADMIN_PASSWORD=changeme

# Orígenes del dashboard (vanilla, React, Vue) para CORS con cookies
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# SOLO para tests automatizados — nunca en producción
# AUTH_DISABLED=1

# Postgres opcional (Compose). Sin esto, la API usa SQLite en api/data/users.db
# DATABASE_URL=postgresql://edf_lab:edf_lab_dev@localhost:5432/edf_lab

# Ruta SQLite alternativa (tests)
# DB_FILE=data/users.test.db
