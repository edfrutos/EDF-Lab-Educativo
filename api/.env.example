# SOLO LABORATORIO — no uses estos valores en producción
# Carga manual en la shell, por ejemplo:
#   export AUTH_ENABLED=true
#   export AUTH_USER=admin
#   export AUTH_PASSWORD=cambiar-en-local
#   export JWT_SECRET=genera-un-secreto-largo-y-aleatorio

# false = API abierta como v1.4 (por defecto si no se define)
AUTH_ENABLED=false

# Requeridos cuando AUTH_ENABLED=true
AUTH_USER=admin
AUTH_PASSWORD=cambiar-en-local
JWT_SECRET=genera-un-secreto-largo-y-aleatorio
